{
  "name": "TEXAS Project Environment",
  "build": { "dockerfile": "../docker/Dockerfile", "context": ".." },

  "workspaceFolder": "/home/micromamba/app",

  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] }
  },

  "settings": {
    "python.defaultInterpreterPath": "/opt/conda/envs/texas-env/bin/python",
    "jupyter.stopJupyterServerOnClose": false,
    "jupyter.logging.level": "debug"
  },

  "runArgs": ["--init", "--shm-size=8g"],
  "hostRequirements": { "gpu": "optional" },

  "overrideCommand": true,
  "shutdownAction": "none",

  "mounts": [
    "source=${localWorkspaceFolder},target=/home/micromamba/app,type=bind,consistency=cached",
    "source=${localEnv:HOME}/OneDrive,target=/mnt/onedrive,type=bind,consistency=cached"
  ],

    "extensions": [
    "ms-python.python",
    "ms-python.pylint"
  ],

  "remoteUser": "micromamba",

  "postCreateCommand": "sudo chown -R micromamba:micromamba /home/micromamba/app /opt/cmdstan && sudo apt update && sudo apt install -y git-lfs && git lfs install",
  "postStartCommand": "echo '[clinfo first lines]'; clinfo | sed -n '1,40p' || true"
}