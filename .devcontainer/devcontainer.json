{
  "name": "TEXAS Project Environment",
  "image": "texas-dev:latest",

  "workspaceFolder": "/home/micromamba/app",

  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] }
  },

  "settings": {
    "python.defaultInterpreterPath": "/opt/conda/bin/python",
    "jupyter.stopJupyterServerOnClose": false,
    "jupyter.logging.level": "debug"
  },

  "runArgs": [
    "--init",             // adds tini to reap zombies
    "--shm-size=8g"
  ],

  "overrideCommand": true,
  "shutdownAction": "none",

  "mounts": [
    "source=${localWorkspaceFolder},target=/home/micromamba/app,type=bind,consistency=cached",
    "source=${localEnv:HOME}/OneDrive,target=/mnt/onedrive,type=bind,consistency=cached"
  ],

  "remoteUser": "micromamba"

  // Re-enable these later once it's stable:
  // "postCreateCommand": "python -m pip install -e .",
  // "postStartCommand": "echo Using Python: $(which python)"
}
