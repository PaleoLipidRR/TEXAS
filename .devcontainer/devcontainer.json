{
  "name": "TEXAS Project Environment",
  "image": "ghcr.io/paleolipidrr/texas:v0.2.0",
  // To build from source instead (e.g. after editing the Dockerfile), replace
  // the "image" line above with:
  //   "build": { "dockerfile": "../docker/Dockerfile", "context": ".." },

  "workspaceFolder": "/home/micromamba/app",

  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter", "ms-python.pylint"] }
  },

  "settings": {
    "python.defaultInterpreterPath": "/opt/conda/envs/texas-env/bin/python",
    "python.terminal.activateEnvironment": false,
    "python.terminal.useEnvFile": true,
    "jupyter.stopJupyterServerOnClose": false,
    "jupyter.logging.level": "debug"
  },

  "runArgs": ["--init", "--shm-size=8g", "--runtime=runc"],
  "hostRequirements": { "gpu": "optional" },

  "overrideCommand": true,
  "shutdownAction": "none",

  "mounts": [
    // Repo root → /home/micromamba/app (always active)
    "source=${localWorkspaceFolder},target=/home/micromamba/app,type=bind,consistency=cached",

    // ── Cloud drive mounts ──────────────────────────────────────────────────
    // Uncomment ONE block below that matches your setup, then
    // run "Dev Containers: Rebuild Container" in VS Code (Ctrl+Shift+P).
    //
    // The mounted folder appears inside the container at /mnt/onedrive.
    // Access it from notebooks with: pd.read_csv("/mnt/onedrive/my_file.csv")
    //
    // IMPORTANT: The local path must already exist on your machine
    // (OneDrive must be locally synced, not cloud-only).

    // Linux — OneDrive via rclone or onedrive client (~/OneDrive)
    "source=${localEnv:HOME}/OneDrive,target=/mnt/onedrive,type=bind,consistency=cached",

    // macOS — OneDrive personal
    // "source=${localEnv:HOME}/Library/CloudStorage/OneDrive-Personal,target=/mnt/onedrive,type=bind,consistency=cached",

    // macOS — OneDrive for Business / university account (adjust folder name)
    // "source=${localEnv:HOME}/Library/CloudStorage/OneDrive-UniversityofArizona,target=/mnt/onedrive,type=bind,consistency=cached",

    // Windows (WSL2) — adjust username
    // "source=/mnt/c/Users/ratta/OneDrive - University of Arizona,target=/mnt/onedrive,type=bind,consistency=cached",

    // ── Google Drive ────────────────────────────────────────────────────────
    // Linux — Google Drive via rclone or google-drive-ocamlfuse (~/GoogleDrive)
    // "source=${localEnv:HOME}/GoogleDrive,target=/mnt/gdrive,type=bind,consistency=cached",

    // macOS — Google Drive desktop client
    // "source=${localEnv:HOME}/Google Drive/My Drive,target=/mnt/gdrive,type=bind,consistency=cached"
  ],

  "remoteUser": "micromamba",
  "updateRemoteUserUID": true,

  "postCreateCommand": "bash .devcontainer/devcontainer-postcreate.sh",
  "postStartCommand": [
    "/bin/sh", "-c",
    "([ -d /opt/cmdstan ] && sudo chown -R micromamba:micromamba /opt/cmdstan || true) && ([ -d /opt/conda/envs/texas-env/bin/cmdstan ] && sudo chown -R micromamba:micromamba /opt/conda/envs/texas-env/bin/cmdstan || true) && echo '[clinfo first lines]' && (clinfo | sed -n '1,40p' 2>/dev/null || echo 'No OpenCL devices detected - continuing without GPU support')"
  ]
}
