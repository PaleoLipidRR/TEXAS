{
  "name": "TEXAS Project Environment",
  "build": { "dockerfile": "../docker/Dockerfile", "context": ".." },

  "workspaceFolder": "/home/micromamba/app",

  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter", "ms-python.pylint"] }
  },

  "settings": {
    "python.defaultInterpreterPath": "/opt/conda/envs/texas-env/bin/python",
    "python.terminal.activateEnvironment": false,
    "jupyter.stopJupyterServerOnClose": false,
    "jupyter.logging.level": "debug"
  },

  "runArgs": ["--init", "--shm-size=8g", "--runtime=runc"],
  "hostRequirements": { "gpu": "optional" },

  "overrideCommand": true,
  "shutdownAction": "none",

  "mounts": [
    "source=${localWorkspaceFolder},target=/home/micromamba/app,type=bind,consistency=cached",
    "source=${localEnv:HOME}/OneDrive,target=/mnt/onedrive,type=bind,consistency=cached"
  ],

  "remoteUser": "micromamba",

  "postCreateCommand": "bash .devcontainer/devcontainer-postcreate.sh",
  "postStartCommand": [
    "/bin/sh", "-c",
    "sudo chown -R micromamba:micromamba /home/micromamba/app /opt/cmdstan && echo '[clinfo first lines]' && (clinfo | sed -n '1,40p' 2>/dev/null || echo 'No OpenCL devices detected - continuing without GPU support')"
  ]
}
