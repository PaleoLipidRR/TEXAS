# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install GUI dependencies
COPY streamlit_app/requirements.streamlit.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install TEXAS package from local source (provides TEXAS.utils.paths etc.)
COPY pyproject.toml /tmp/texas-pkg/
COPY src/TEXAS /tmp/texas-pkg/src/TEXAS
RUN pip install --no-cache-dir /tmp/texas-pkg

# Copy the Streamlit app
COPY streamlit_app ./streamlit_app

# Streamlit config
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Cache dirs — set here as defaults; docker-compose.yml overrides at runtime
ENV TEXAS_INV_CACHE=/app/data/cache/TEXAS_invT_posterior_cache \
    TEXAS_FWD_CACHE=/app/data/cache/TEXAS_posterior_cache

EXPOSE 8501
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["streamlit","run","streamlit_app/main.py","--server.address=0.0.0.0","--server.port=8501"]
