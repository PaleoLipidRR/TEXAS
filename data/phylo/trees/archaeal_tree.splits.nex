#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'Nitrosopumilus_maritimus'
[2] 'Methanobrevibacter_smithii'
[3] 'Methanosarcina_barkeri'
[4] 'Pyrococcus_furiosus'
[5] 'Sulfolobus_solfataricus'
[6] 'Escherichia_coli'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=13;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 4,
	100	 6,
	100	 4 6,
	70	 1 3 5,
	100	 3,
	100	 5,
	100	 3 5,
	100	 1,
	6	 1 2,
	24	 1 4 6,
	0	 1 3,
	0	 1 5,
;
END; [Splits]

