[build-system]
requires = ["setuptools>=64", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "TEXAS"
version = "0.1.0"
authors = [{ name = "Ronnakrit Rattanasriampaipong", email = "rattanasriampaipong.r@gmail.com" }]
description = "Bayesian GDGT–temperature utilities"
readme = "README.md"
requires-python = ">=3.8"
license = { text = "MIT" }
classifiers = [
  "Programming Language :: Python :: 3",
  "License :: OSI Approved :: MIT License",
  "Operating System :: OS Independent",
]

# Core Python dependencies required by your library
# These are also used by conda-lock
dependencies = [
  "numpy>=1.18",
  "xarray>=0.16",
  "cmdstanpy>=1.0",
  "typing-extensions>=3.7.4",
  "scipy>=1.7",
  "pandas>=1.3",
  "baysparpy>=0.1",
  "baysplinepy>=0.1",
  "stanio",
  "geopandas",
  "shapely",
  "cartopy",
  "pyproj<3.6",
  "rtree",
  "pyogrio",
  "mapclassify",
  "geopy",
  "xesmf",
  "esmpy",
  "esmf",
  "mpich",
  "hdf5",
  "libnetcdf"
]

[project.optional-dependencies]
# Dependencies for plotting and development
plotting = [
    "matplotlib<3.5",
    "proplot==0.9.7",
    "cmocean",
    "setuptools<81",
    "plotly"
]

dev = [
  "ipykernel",
  "pytest",
  "mkdocs",
  "jupyterlab",
  "ipywidgets",
  "tqdm",
  "anywidget",
  "ipylab",
  "duckdb",
  "pyarrow",
  "sqlalchemy",
  "pydantic"
]

all = [
    "TEXAS[plotting]",
    "TEXAS[dev]",
]

[tool.setuptools.packages.find]
where = ["src"]
include = ["TEXAS*"]

[tool.setuptools.package-data]
TEXAS = ["stan_models/*.stan"]

[project.urls]
"Homepage" = "https://github.com/PaleoLipidRR/TEXAS"
"Bug Tracker" = "https://github.com/PaleoLipidRR/TEXAS/issues"

# Add this new section for conda-lock to handle pip-only packages
[tool.conda-lock.dependencies]
pip = [
    "pygwalker"
]
