!data/cache/TEXAS_invT_posterior_cache/
*.nc

review_archive_v*/
texas-psm-zenodo-v*
legacy_*.tar.gz

*.backup
*.bak
*.old
*~
.DS_Store
Thumbs.db
**/temp/
**/tmp/
**/.cache/
