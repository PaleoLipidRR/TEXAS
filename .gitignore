
# Claude Code local settings (machine-specific paths and permissions)
.claude/settings.local.json

# Machine-specific backup files (hostname embedded in filename)
*safeBackup*

# Zenodo review archive staging (local only — never commit)
review_archive_v*/
texas-psm-zenodo-v*.zip
texas-psm-zenodo-v*/

# Stray files
*.Rhistory
=*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.env
*.egg-info/
*.egg
.eggs/
.coverage
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
notebooks/dask-worker-space/
notebooks/manuscripts/regrid_weights_*.nc
notebooks/manuscripts/*.pkl
notebooks/manuscripts/*.png
notebooks/exploration/

# Manuscript draft (pre-publication)
/manuscript/

# Data — large external datasets (download separately, see data/README.md)
data/external/

# Model caches (ignore old/stray locations, keep data/cache)
**/posterior_cache/
**/invT_posterior_cache/

# Compiled Stan model binaries (auto-generated by CmdStan, platform-specific)
src/TEXAS/stan_models/gen_logi_*
src/TEXAS/stan_models/invT_*
src/TEXAS/stan_models/logistic_*
src/TEXAS/stan_models/linear_*
# Re-include .stan source files (negation overrides binary-glob rules above)
!src/TEXAS/stan_models/*.stan
# Docs — gitignored by default; selectively un-ignore specific files when ready
# to make them public by adding negation rules below, e.g.:
#   !docs/index.md
#   !docs/reduce_sum_for_geologists.md
# docs/

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Build artifacts
build/
dist/

# Generated outputs
outputs/
site/
html_figures/
figures/   # ← uncomment if you want to ignore generated plots too
data/cache/
data/spreadsheets/
*.xlsx
*.csv
data/spreadsheets/*.xlsx
data/spreadsheets/*.csv
data/*.xlsx
data/*.csv

# Jupyter Book tutorial build output
tutorial/_build/
docs/_build/

# Superpowers workflow artifacts (specs, plans, and scratch ledger)
.superpowers/
docs/superpowers/
