# ───── Python cache / build artifacts ─────
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
build/
dist/

# ───── Stan compiled models (keep only .stan source) ─────
TEXAS/stan_models/**
!TEXAS/stan_models/**/*.stan

# ───── Notebooks ─────
# Track all notebooks, but ignore temp dirs
!notebooks/**/*.ipynb
/notebooks/dask-worker-space/

# ───── Temporary / OS / IDE files ─────
.vscode/
.idea/
.DS_Store

# ───── Large or generated data files ─────
*.nc
*.csv
*.xlsx
*.pkl
*.npz

# ───── Generated figures ─────
/figures/
/html_figures/

# ───── Posterior caches ─────
/TEXAS/posterior_cache/
/TEXAS/invT_posterior_cache/

# ───── Other project data dirs ─────
/spreadsheets/
/nc_files/
/tmp/

# machine-specific json file
.devcontainer/devcontainer.gpu-fix.json
